generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 🌟 ENUMS (Strict allowed values to prevent AI hallucination)
// ============================================================
enum SubscriptionStatus {
  Trial
  Active
  Expired
  Cancelled
}

enum OperationalStatus {
  Available
  Occupied
  Maintenance
}

enum HousekeepingStatus {
  Clean
  Dirty
  Inspected
}

enum ReservationStatus {
  Pending
  Confirmed
  InHouse      // 🌟 NEW: Replaces "CheckedIn" at the reservation level
  Completed    // 🌟 NEW: Replaces "CheckedOut" at the reservation level
  Cancelled
  Expired      // 🌟 NEW: Auto-set when check-in date passes with no action
  NoShow       // 🌟 KEPT: Explicitly marked by receptionist as a no-show
}

enum PaymentStatus {
  Pending
  Completed
  Failed
  Refunded
  Voided
}

// ============================================================
// CORE - PROPERTY
// ============================================================
model Property {
  propertyId             Int       @id @default(autoincrement())
  propertyCode           String    @unique @db.VarChar(50)
  propertyName           String    @db.VarChar(200)
  businessName           String    @db.VarChar(200)
  legalName              String?   @db.VarChar(200)
  subscriptionPlan       String    @default("Starter") @db.VarChar(50)
  subscriptionStatus     SubscriptionStatus @default(Trial)
  trialEndsAt            DateTime?
  subscriptionEndsAt     DateTime?
  subscriptionReminderFor DateTime?
  subscriptionExpiryNoticeFor DateTime?
  subscriptionPackage    String?   @db.VarChar(30)
  roomAllowance          Int?
  staffAllowance         Int?
  subscriptionMonthlyPrice Decimal? @db.Decimal(10, 2)
  subscriptionDiscountPercent Decimal? @db.Decimal(5, 2)
  scheduledSubscription  Json?
  subscriptionOverride   Json?
  currency              String    @default("GHS") @db.VarChar(10)
  timezone               String    @default("Africa/Accra") @db.VarChar(50)
  logo                   String?   @db.Text
  primaryEmail           String?   @db.VarChar(200)
  primaryPhone           String?   @db.VarChar(50)
  primaryPhoneWhatsappOnly Boolean  @default(false)
  isActive               Boolean   @default(true)

  propertyType           String    @db.VarChar(50)
  address                String?   @db.Text
  area                   String?   @db.VarChar(150)
  city                   String?   @db.VarChar(100)
  region                 String?   @db.VarChar(100)
  ghanaPostAddress       String?   @db.VarChar(20)
  country                String    @db.VarChar(100) 
  latitude               Float?
  longitude              Float?
  totalRooms             Int       @default(0)
  checkInTime            String    @default("14:00") @db.VarChar(10)
  checkOutTime           String    @default("11:00") @db.VarChar(10)
  status                 String    @default("Active") @db.VarChar(20)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  coverImage             String?   @db.Text
  galleryImages          Json?
  publicDescription      String?   @db.Text
  cancellationPolicy     String?   @db.Text
  houseRules             String?   @db.Text
  taxPercentage          Decimal   @default(0.00) @db.Decimal(5, 2)
  isOnlineBookingEnabled Boolean   @default(false)
  paystackSecretKey      String?   @db.Text // legacy: no longer used (payments moved to Moolre)
  moolreUsername         String?   @db.VarChar(100)
  moolrePublicKey        String?   @db.Text
  moolreAccountNumber    String?   @db.VarChar(50)
  moolreWebhookSecret    String?   @db.Text
  refundSimulationEnabled Boolean @default(false)
  isNonRefundable     Boolean @default(true) // hotel keeps the money on cancellation; refunds only as a recorded exception
  allowEarlyDepartureChargeReduction Boolean @default(false) // if false, early checkout keeps the original agreed charges
  earlyDepartureChargeReductionPenaltyPercent Decimal @default(0) @db.Decimal(5, 2) // share of unused nights the hotel keeps when charges are reduced
  housekeepingEnabled Boolean @default(false)
  smsSimulationEnabled Boolean @default(false)

  users                  User[]
  propertyGuests         PropertyGuest[]
  roomTypes              RoomType[]
  rooms                  Room[]
  ratePlans              RatePlan[]
  reservations           Reservation[]
  amenities              Amenity[]
  payments               Payment[] // 🌟 NEW: Opposite relation for Payment
  subscriptionPayments   SubscriptionPayment[]
  correctionRequests     CorrectionRequest[]
  refunds                Refund[]
  cashCounts             CashCount[]
  cashCountIssues        CashCountIssue[]
  simulatedSms           SimulatedSms[]
  websiteDomains         PropertyWebsiteDomain[]
  hotelGuestAccounts     HotelGuestAccount[]
  memberships            PropertyMembership[]

  @@map("properties")
}

// Which properties an account can work in. User.propertyId stays the account's
// home property; owners get one extra row per additional property they manage.
model PropertyMembership {
  membershipId Int      @id @default(autoincrement())
  userId       Int
  propertyId   Int
  isOwner      Boolean  @default(false) // the registered owner: excluded from staff limits
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  property     Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([propertyId])
  @@map("property_memberships")
}

model PropertyWebsiteDomain {
  domainId    Int      @id @default(autoincrement())
  hostname    String   @unique @db.VarChar(253)
  propertyId  Int
  isActive    Boolean  @default(false)
  autoActivate Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  property    Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_website_domains")
}

// ============================================================
// RBAC - USERS, ROLES, PERMISSIONS
// ============================================================
model SimulatedSms {
  messageId     Int      @id @default(autoincrement())
  propertyId    Int
  reservationId String
  eventKey      String   @unique @db.VarChar(180)
  kind          String   @db.VarChar(40)
  recipient     String   @db.VarChar(20)
  body          String   @db.Text
    provider      String   @default("simulation") @db.VarChar(20)
    providerReference String? @unique @db.VarChar(180)
    sendStatus    String   @default("simulated") @db.VarChar(30)
    providerCode  String?  @db.VarChar(30)
    providerDeliveryStatus String? @db.VarChar(30)
    acceptedAt    DateTime?
    statusCheckedAt DateTime?
    failureReason String?  @db.VarChar(100)
  createdAt     DateTime @default(now())

  property      Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("simulated_sms")
}

model User {
  userId            Int       @id @default(autoincrement())
  propertyId        Int?
  fullName          String    @db.VarChar(200)
  username          String    @unique
  email             String?   @unique @db.VarChar(200)
  phone             String?   @unique @db.VarChar(20)
  passwordHash      String    @db.Text
  invitationTokenHash String? @unique
  invitationExpiresAt DateTime?
  invitationPending Boolean @default(false)
  passwordResetTokenHash String? @unique
  passwordResetExpiresAt DateTime?
  sessionVersion String?
  correctionPermissions Json @default("[\"undo-checkin\",\"undo-checkout\",\"restore\",\"transfer\"]")
  financialDelegation Json @default("{}")
  canManageOnlineRooms Boolean @default(false)
  roleId            Int
  isPlatformAdmin   Boolean   @default(false)
  isActive          Boolean   @default(true)
  lastPropertyId    Int?      // property opened at next sign-in (multi-property owners)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property          Property? @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  role              Role      @relation(fields: [roleId], references: [roleId])
  reservations      Reservation[] @relation("staffReservations")
  payments          Payment[] @relation("receivedPayments")
  auditLogs         AuditLog[]
  presenceUpdates   ReservationRoom[] @relation("presenceUpdatedBy")
  initiatedSubscriptionPayments SubscriptionPayment[] @relation("initiatedSubscriptionPayments")
  requestedCorrections CorrectionRequest[] @relation("correctionRequester")
  reviewedCorrections CorrectionRequest[] @relation("correctionReviewer")
  returnedRefunds Refund[]
  cashCountsCounted  CashCount[] @relation("cashCountStaff")
  cashCountsRecorded CashCount[] @relation("cashCountRecorder")
  cashCountIssuesStaff CashCountIssue[] @relation("cashCountIssueStaff")
  cashCountIssuesRecorded CashCountIssue[] @relation("cashCountIssueRecorder")
  memberships       PropertyMembership[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Role {
  roleId            Int       @id @default(autoincrement())
  roleName          String    @unique @db.VarChar(50)
  description       String?   @db.Text
  isSystem          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  rolePermissions   RolePermission[]

  @@map("roles")
}

model Permission {
  permissionId      Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(100)
  name              String    @db.VarChar(100)
  description       String?   @db.Text
  category          String?   @db.VarChar(50)
  createdAt         DateTime  @default(now())

  rolePermissions   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  rolePermissionId  Int       @id @default(autoincrement())
  roleId            Int
  permissionId      Int

  role              Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission        Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================================
// GUESTS
// ============================================================
model PropertyGuest {
  guestId        Int       @id @default(autoincrement())
  propertyId     Int       
  fullName       String    @db.VarChar(200)
  phone          String?   @db.VarChar(50)
  email          String?   @db.VarChar(200)
  idNumber       String?   @db.VarChar(50)
  address        String?   @db.Text
  city           String?   @db.VarChar(100)
  country        String?   @db.VarChar(100)
  notes          String?   @db.Text
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  property       Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  reservations   Reservation[]

  @@unique([propertyId, phone])
  @@index([propertyId])
  @@index([phone])
  @@map("property_guests")
}

model PlatformGuest {
  guestId           Int       @id @default(autoincrement())
  fullName          String    @db.VarChar(200)
  phone             String    @unique @db.VarChar(50)
  email             String?   @unique @db.VarChar(200)
  googleSubject     String?   @unique @db.VarChar(255)
  passwordHash      String?    @db.Text
  centralPasswordHash String? @db.Text
  isPhoneVerified   Boolean   @default(false)
  isEmailVerified   Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reservations      Reservation[]
  phoneChallenges   GuestPhoneChallenge[]
  hotelAccounts     HotelGuestAccount[]

  @@index([phone])
  @@index([email])
  @@map("platform_guests")
}

model HotelGuestAccount {
  propertyId      Int
  email           String @db.VarChar(200)
  platformGuestId Int
  passwordHash    String @db.Text
  sessionVersion  Int    @default(1)
  property        Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  platformGuest   PlatformGuest @relation(fields: [platformGuestId], references: [guestId], onDelete: Cascade)

  @@id([propertyId, email])
  @@index([platformGuestId])
  @@map("hotel_guest_accounts")
}

model GuestEmailChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar(200)
  propertyId Int?
  codeHash   String   @db.VarChar(64)
  attempts   Int      @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  setupUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@map("guest_email_challenges")
}

model GuestPhoneChallenge {
  id          String   @id @default(uuid()) @db.Uuid
  phone       String   @db.VarChar(50)
  codeHash    String   @db.VarChar(64)
  purpose     String   @db.VarChar(20)
  googleSub   String?  @db.VarChar(255)
  googleEmail String?  @db.VarChar(200)
  googleName  String?  @db.VarChar(200)
  attempts    Int      @default(0)
    smsProvider String   @default("simulation") @db.VarChar(20)
    smsReference String? @unique @db.VarChar(180)
    smsState    String   @default("simulated") @db.VarChar(30)
    smsAcceptedAt DateTime?
    smsStatusCheckedAt DateTime?
    smsDeliveryStatus String? @db.VarChar(30)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  guestId     Int?
  guest       PlatformGuest? @relation(fields: [guestId], references: [guestId], onDelete: SetNull)

  @@index([phone, createdAt])
  @@map("guest_phone_challenges")
}

// ============================================================
// ROOM INVENTORY
// ============================================================
model RoomType {
  roomTypeId        Int       @id @default(autoincrement())
  propertyId        Int
  typeName          String    @db.VarChar(100)
  description       String?   @db.Text
  basePrice         Decimal   @db.Decimal(10, 2)
  maxOccupancy      Int       @default(1)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  coverImage        String?   @db.Text
  galleryImages     Json?

  property          Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  rooms             Room[]
  ratePlans         RatePlan[]
  reservationRooms  ReservationRoom[]
  amenities         RoomTypeAmenity[]

  @@unique([propertyId, typeName])
  @@map("room_types")
}

model Room {
  roomId               Int       @id @default(autoincrement())
  propertyId           Int
  roomNumber           String    @db.VarChar(20)
  roomTypeId           Int
  floor                Int?
  operationalStatus    OperationalStatus @default(Available)
  housekeepingStatus   HousekeepingStatus @default(Clean)
  maintenanceReason    String?   @db.VarChar(200)
  isOnlineBookable     Boolean   @default(true)
  notes                String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  property             Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  roomType             RoomType  @relation(fields: [roomTypeId], references: [roomTypeId])
  reservationRooms     ReservationRoom[]

  @@unique([propertyId, roomNumber])
  @@map("rooms")
}

model RatePlan {
  ratePlanId        Int       @id @default(autoincrement())
  propertyId        Int
  roomTypeId        Int
  planName          String    @db.VarChar(100)
  description       String?   @db.Text
  isPublic          Boolean   @default(true)
  minStay           Int       @default(1)
  maxStay           Int?      @default(14)
  discountPercent   Decimal?  @db.Decimal(5, 2)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property          Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  roomType          RoomType  @relation(fields: [roomTypeId], references: [roomTypeId])
  reservationRooms  ReservationRoom[]

  @@unique([propertyId, roomTypeId, planName])
  @@map("rate_plans")
}

// ============================================================
// RESERVATIONS
// ============================================================
model Reservation {
  reservationId     String    @id @default(uuid()) // 🌟 CHANGED TO UUID
  propertyId        Int
  
  confirmationCode  String    @unique
  propertyGuestId   Int?
  platformGuestId   Int?
  guestNameSnapshot String?   @db.VarChar(200)
  guestPhoneSnapshot String?  @db.VarChar(50)
  
  staffId           Int?
  source            String    @default("Website") @db.VarChar(50)
  checkInDate       DateTime
  checkOutDate      DateTime
  status            ReservationStatus @default(Pending)
  notes             String?   @db.Text
  totalAmount       Decimal?  @db.Decimal(10, 2)
  amountPaid        Decimal?  @db.Decimal(10, 2)
  refundDue         Decimal   @default(0) @db.Decimal(10, 2)
  refundStatus      String    @default("None") @db.VarChar(20)
  cancellationDate  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  property          Property       @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  propertyGuest     PropertyGuest? @relation(fields: [propertyGuestId], references: [guestId], onDelete: SetNull)
  platformGuest     PlatformGuest? @relation(fields: [platformGuestId], references: [guestId], onDelete: SetNull)
  staff             User?          @relation("staffReservations", fields: [staffId], references: [userId])
  reservationRooms  ReservationRoom[]
  payments          Payment[]
  guestPaymentAttempts GuestPaymentAttempt[]
  correctionRequests CorrectionRequest[]
  refunds Refund[]

  @@index([propertyId])
  @@index([propertyGuestId])
  @@index([platformGuestId])
  @@index([status])
  @@index([checkInDate, checkOutDate])
  @@map("reservations")
}

model CorrectionRequest {
  requestId Int @id @default(autoincrement())
  propertyId Int
  reservationId String
  requestedBy Int?
  reviewedBy Int?
  action String @db.VarChar(40)
  input Json
  expectedVersion String @db.Text
  status String @default("Pending") @db.VarChar(20)
  reviewReason String? @db.VarChar(500)
  createdAt DateTime @default(now())
  reviewedAt DateTime?
  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  requester User? @relation("correctionRequester", fields: [requestedBy], references: [userId], onDelete: SetNull)
  reviewer User? @relation("correctionReviewer", fields: [reviewedBy], references: [userId], onDelete: SetNull)
  refund Refund?
  @@index([propertyId, status, createdAt])
  @@index([reservationId, status])
  @@map("correction_requests")
}

model ReservationRoom {
  reservationRoomId   Int       @id @default(autoincrement())
  reservationId       String    // 🌟 CHANGED TO STRING (Matches Reservation UUID)
  roomId              Int?
  roomTypeId          Int?
  ratePlanId          Int?
  roomNumberSnapshot  String?   @db.VarChar(20)
  roomTypeNameSnapshot String?  @db.VarChar(100)
  checkInDate         DateTime
  checkOutDate        DateTime
  originalCheckOutDate DateTime?
  agreedPricePerNight Decimal   @db.Decimal(10, 2)
  earlyDeparturePenalty Decimal @default(0) @db.Decimal(10, 2) // charge kept for unused nights removed by an early departure (before tax)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  status              String    @default("Reserved")
  occupantName        String?
  occupantPhone       String?   @db.VarChar(30)
  guestPresenceStatus String    @default("InRoom") @db.VarChar(20)
  guestOutAt          DateTime?
  expectedReturnAt    DateTime?
  guestReturnedAt     DateTime?
  presenceUpdatedBy   Int?
  actualCheckIn       DateTime?
  actualCheckOut      DateTime?

  reservation         Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  room                Room?     @relation(fields: [roomId], references: [roomId], onDelete: SetNull)
  roomType            RoomType? @relation(fields: [roomTypeId], references: [roomTypeId], onDelete: SetNull)
  ratePlan            RatePlan? @relation(fields: [ratePlanId], references: [ratePlanId], onDelete: SetNull)
  presenceUpdatedByUser User?   @relation("presenceUpdatedBy", fields: [presenceUpdatedBy], references: [userId], onDelete: SetNull)

  @@unique([reservationId, roomId])
  @@index([reservationId])
  @@index([roomId])
  @@index([checkInDate, checkOutDate])
  @@map("reservation_rooms")
}

// ============================================================
// PAYMENTS
// ============================================================
model Payment {
  paymentId         Int       @id @default(autoincrement())
  reservationId     String    
  propertyId        Int?      //  NEW: Optional so it works with existing rows
  amount            Decimal   @db.Decimal(10, 2)
  paymentMethod     String    @db.VarChar(50)
  paymentDate       DateTime  @default(now())
  gatewayReference  String?   @db.VarChar(200)
  // Set only when the payment provider itself confirmed this payment (e.g. "Paystack"). Such payments are immutable.
  verifiedProvider  String?   @db.VarChar(30)
  verifiedAt        DateTime?
  receivedBy        Int?
  status            PaymentStatus @default(Completed)
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reservation       Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  property          Property?   @relation(fields: [propertyId], references: [propertyId]) // 🌟 ONLY ONE 'property' field
  receiver          User?       @relation("receivedPayments", fields: [receivedBy], references: [userId])
  refunds           Refund[]

  @@index([reservationId])
  @@index([propertyId])
  @@index([paymentDate])
  @@map("payments")
}

model Refund {
  refundId Int @id @default(autoincrement())
  isSimulated Boolean @default(false)
  requestId Int @unique
  propertyId Int
  reservationId String
  paymentId Int
  amount Decimal @db.Decimal(10, 2)
  method String @db.VarChar(30)
  reference String? @db.VarChar(200)
  returnedBy Int?
  returnedByName String @db.VarChar(200)
  returnedAt DateTime
  createdAt DateTime @default(now())
  request CorrectionRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [paymentId], onDelete: Restrict)
  returner User? @relation(fields: [returnedBy], references: [userId], onDelete: SetNull)
  @@index([reservationId])
  @@index([paymentId])
  @@index([propertyId, returnedAt])
  @@unique([propertyId, method, reference])
  @@map("refunds")
}

model GuestPaymentAttempt {
  attemptId Int @id @default(autoincrement())
  reservationId String
  reference String @unique @db.VarChar(200)
  amount Decimal @db.Decimal(10, 2)
  currency String @db.VarChar(10)
  status String @default("Initializing") @db.VarChar(30)
  checkoutUrl String? @db.Text
  payer String? @db.VarChar(20)
  channel String? @db.VarChar(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reservation Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  @@index([reservationId, status])
  @@map("guest_payment_attempts")
}

model SubscriptionPayment {
  subscriptionPaymentId Int       @id @default(autoincrement())
  propertyId             Int
  initiatedBy            Int?
  reference              String    @unique @db.VarChar(100)
  amount                 Decimal   @db.Decimal(10, 2)
  currency               String    @default("GHS") @db.VarChar(10)
  durationMonths         Int
  planName               String    @default("Pro") @db.VarChar(50)
  status                 SubscriptionPaymentStatus @default(Pending)
  // Purchased terms are frozen here so later price changes never alter a paid order.
  kind                   SubscriptionChangeKind @default(Renewal)
  packageCode            String?   @db.VarChar(30)
  roomAllowance          Int?
  staffAllowance         Int?
  monthlyPrice           Decimal?  @db.Decimal(10, 2)
  discountPercent        Decimal   @default(0) @db.Decimal(5, 2)
  prorationAmount        Decimal   @default(0) @db.Decimal(10, 2)
  pricing                Json?
  payer                  String?   @db.VarChar(20)
  channel                String?   @db.VarChar(10)
  providerStep           String?   @db.VarChar(30) // Moolre progress: otp_required, verifying, prompt_sent, unknown
  createdAt              DateTime  @default(now())
  paidAt                 DateTime?

  property               Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  initiator              User?     @relation("initiatedSubscriptionPayments", fields: [initiatedBy], references: [userId], onDelete: SetNull)

  @@index([propertyId, status])
  @@index([createdAt])
  @@map("subscription_payments")
}

enum SubscriptionPaymentStatus {
  Pending
  Processing
  Completed
  Failed
}

enum SubscriptionChangeKind {
  New
  Renewal
  Upgrade
  Downgrade
}

// Single-row platform configuration for packages, pricing, durations and trial terms.
model SubscriptionSettings {
  id                     Int       @id @default(1)
  config                 Json
  updatedBy              Int?
  updatedAt              DateTime  @updatedAt

  @@map("subscription_settings")
}



// ============================================================
// AUDIT LOG
// ============================================================
model AuditLog {
  auditLogId        Int       @id @default(autoincrement())
  userId            Int?
  propertyId        Int?      // property the action happened in (null on older rows: use the user's home property)
  action            String    @db.VarChar(100)
  entityType        String    @db.VarChar(50)
  entityId          Int?
  oldData           Json?
  newData           Json?
  ipAddress         String?   @db.VarChar(50)
  userAgent         String?   @db.Text
  createdAt         DateTime  @default(now())

  user              User?     @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([propertyId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// AMENITIES
// ============================================================
model Amenity {
  amenityId         Int       @id @default(autoincrement())
  propertyId        Int
  name              String    @db.VarChar(100)
  icon              String?   @db.VarChar(50)
  createdAt         DateTime  @default(now())

  property          Property  @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  roomTypes         RoomTypeAmenity[]

  @@unique([propertyId, name]) 
  @@map("amenities")
}

model RoomTypeAmenity {
  roomTypeId        Int
  amenityId         Int

  roomType          RoomType  @relation(fields: [roomTypeId], references: [roomTypeId], onDelete: Cascade)
  amenity           Amenity   @relation(fields: [amenityId], references: [amenityId], onDelete: Cascade)

  @@id([roomTypeId, amenityId])
  @@map("room_type_amenities")
}

// End-of-day cash count for one staff member's cash on one hotel date. Append-only: a recount adds a
// new row. expectedAmount is a snapshot taken when the count was saved; later corrections change the
// live report but never this record.
model CashCount {
  cashCountId    Int      @id @default(autoincrement())
  propertyId     Int
  businessDate   DateTime @db.Date
  staffUserId    Int
  expectedAmount Decimal  @db.Decimal(10, 2)
  countedAmount  Decimal  @db.Decimal(10, 2)
  difference     Decimal  @db.Decimal(10, 2)
  note           String?  @db.VarChar(300)
  recordedBy     Int
  recordedAt     DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  staff    User     @relation("cashCountStaff", fields: [staffUserId], references: [userId])
  recorder User     @relation("cashCountRecorder", fields: [recordedBy], references: [userId])

  @@index([propertyId, businessDate])
  @@index([staffUserId])
  @@map("cash_counts")
}

// Append-only explanations for cash counts that could not be completed.
model CashCountIssue {
  cashCountIssueId Int @id @default(autoincrement())
  propertyId Int
  businessDate DateTime @db.Date
  staffUserId Int
  reason String @db.VarChar(300)
  recordedBy Int
  recordedAt DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [propertyId], onDelete: Cascade)
  staff User @relation("cashCountIssueStaff", fields: [staffUserId], references: [userId])
  recorder User @relation("cashCountIssueRecorder", fields: [recordedBy], references: [userId])

  @@index([propertyId, businessDate])
  @@index([staffUserId])
  @@map("cash_count_issues")
}


// ============================================================
// PUSH NOTIFICATIONS (staff devices that allowed notifications)
// ============================================================
model PushSubscription {
  subscriptionId Int       @id @default(autoincrement())
  userId         Int
  endpoint       String    @unique
  p256dh         String    @db.VarChar(200)
  auth           String    @db.VarChar(100)
  userAgent      String?   @db.VarChar(300)
  createdAt      DateTime  @default(now())
  lastSuccessAt  DateTime?

  user           User      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// One row per notification that must only ever be sent once (e.g. one overstay alert per stay).
model PushNotice {
  key       String   @id @db.VarChar(200)
  createdAt DateTime @default(now())

  @@map("push_notices")
}

// ============================================================
// IDEMPOTENCY (a save sent twice — e.g. after a lost reply on a weak signal — is done only once)
// ============================================================
model IdempotencyRecord {
  recordId       Int      @id @default(autoincrement())
  scope          String   @db.VarChar(80)
  key            String   @db.VarChar(100)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(300)
  requestHash    String   @db.VarChar(64)
  state          String   @db.VarChar(20)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}
